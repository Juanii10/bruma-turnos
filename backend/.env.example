# Servidor
PORT=3001
FRONTEND_URL=http://localhost:4321

# Base de datos (SQLite local por defecto). Para producción con Postgres/Neon
# ver instrucciones de deploy en el README.
DATABASE_FILE=./data/bruma.db

# Auth admin
JWT_SECRET=cambiar-este-secreto-en-produccion

# Mail (opcional). Si no se completan estas variables, el sistema envía los
# mails en "modo simulado" (los imprime por consola) para poder probar todo
# el flujo sin necesidad de una cuenta de mail real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BRUMA <no-reply@bruma.com>"
