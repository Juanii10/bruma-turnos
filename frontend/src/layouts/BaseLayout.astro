---
import '../styles/global.css';

const { title = 'BRUMA — Peluquería & Barbería', description = 'Reservá tu turno online en BRUMA.' } = Astro.props;
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/profesionales', label: 'Equipo' },
  { href: '/reservar', label: 'Reservar turno' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-ink/10">
      <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
        <a href="/" class="font-display text-2xl tracking-wide text-ink">BRUMA</a>

        <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-ink-soft">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition-colors hover:text-copper',
                  currentPath === link.href && 'text-copper',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <a
          href="/reservar"
          class="hidden md:inline-flex items-center rounded-full bg-copper px-5 py-2 text-sm font-semibold text-cream transition-colors hover:bg-copper-dark"
        >
          Reservar turno
        </a>

        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer p-2 -mr-2 text-ink">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </summary>
          <ul class="absolute right-0 mt-2 w-52 rounded-xl border border-ink/10 bg-cream shadow-lg p-2 flex flex-col">
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class="block rounded-lg px-3 py-2 text-sm text-ink-soft hover:bg-cream-dark">{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink/10 bg-ink text-cream/80">
      <div class="max-w-6xl mx-auto px-6 py-10 grid gap-8 md:grid-cols-3 text-sm">
        <div>
          <p class="font-display text-xl text-cream">BRUMA</p>
          <p class="mt-2 text-cream/60">Peluquería & barbería de barrio, con turnos online.</p>
        </div>
        <div>
          <p class="font-semibold text-cream mb-2">Contacto</p>
          <p>Av. Cabildo 2450, CABA</p>
          <p>+54 9 11 5555-1234</p>
          <p>@bruma.estudio</p>
        </div>
        <div>
          <p class="font-semibold text-cream mb-2">Horarios</p>
          <p>Lunes a sábados de 10 a 19 hs</p>
        </div>
      </div>
      <div class="border-t border-cream/10 py-4 text-center text-xs text-cream/40">
        Proyecto de portfolio — no es un negocio real.
      </div>
    </footer>
  </body>
</html>
