---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesList from '../components/ServicesList.jsx';
---

<BaseLayout>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-20 md:pt-24 md:pb-28 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="uppercase tracking-[0.2em] text-xs font-semibold text-copper-dark mb-4">Peluquería & Barbería</p>
      <h1 class="font-display text-4xl md:text-5xl leading-tight text-ink mb-6">
        Tu turno, reservado en menos de un minuto.
      </h1>
      <p class="text-ink-soft text-lg mb-8 max-w-md">
        Elegí el servicio, el profesional y el horario que más te convenga. Sin llamadas, sin esperas: reservá
        online cuando quieras.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/reservar"
          class="inline-flex items-center rounded-full bg-copper px-7 py-3 font-semibold text-cream hover:bg-copper-dark transition-colors"
        >
          Reservar turno
        </a>
        <a
          href="/servicios"
          class="inline-flex items-center rounded-full border border-ink/20 px-7 py-3 font-semibold text-ink hover:border-copper transition-colors"
        >
          Ver servicios
        </a>
      </div>
    </div>
    <div class="relative">
      <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-copper-light via-cream-dark to-cream border border-ink/10"></div>
      <div class="absolute -bottom-6 -left-6 rounded-2xl bg-ink text-cream px-6 py-4 shadow-xl">
        <p class="font-display text-2xl">+3.000</p>
        <p class="text-xs text-cream/70">turnos reservados online</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="flex items-end justify-between mb-6">
      <h2 class="font-display text-3xl text-ink">Nuestros servicios</h2>
      <a href="/servicios" class="text-sm font-semibold text-copper-dark hover:underline">Ver todos →</a>
    </div>
    <ServicesList compact client:load />
  </section>

  <section class="bg-ink text-cream">
    <div class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-3 gap-8 text-center">
      <div>
        <p class="font-display text-3xl mb-2">1</p>
        <p class="text-cream/70 text-sm">Elegí servicio, profesional y horario disponible.</p>
      </div>
      <div>
        <p class="font-display text-3xl mb-2">2</p>
        <p class="text-cream/70 text-sm">Confirmá con una seña para asegurar tu lugar.</p>
      </div>
      <div>
        <p class="font-display text-3xl mb-2">3</p>
        <p class="text-cream/70 text-sm">Recibís recordatorio por mail antes de tu turno.</p>
      </div>
    </div>
  </section>
</BaseLayout>
