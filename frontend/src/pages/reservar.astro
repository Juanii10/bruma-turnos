---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWizard from '../components/BookingWizard.jsx';
---

<BaseLayout title="Reservar turno — BRUMA">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <p class="uppercase tracking-[0.2em] text-xs font-semibold text-copper-dark mb-3 text-center">Reserva online</p>
    <h1 class="font-display text-4xl text-ink mb-10 text-center">Reservá tu turno</h1>
    <BookingWizard client:load />
  </section>
</BaseLayout>
